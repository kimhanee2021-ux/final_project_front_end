# 개발 서버 프록시 대상(백엔드 주소). 비워두면 http://localhost:8080
VITE_BACKEND_URL=
# 프록시 없이 백엔드를 직접 호출할 때만 지정 (예: 배포). 비워두면 같은 출처의 /api 사용
VITE_API_BASE_URL=
# 선택: AI 로컬 검증용 백엔드 주소. 설정하면 VITE_BACKEND_URL보다 우선한다.
AI_API_TARGET=
# Gemini 키는 백엔드 .env의 GEMINI_API_KEY에만 설정한다.

# FastAPI 추천 서버 주소(개발 서버 프록시 /recommend-api 대상). 비워두면 http://localhost:8000
AI_RECOMMEND_TARGET=
# 프록시 없이 추천 서버를 직접 호출할 때만 지정 (예: 배포). 비워두면 /recommend-api 사용
VITE_RECOMMEND_API_BASE_URL=
